# ---- PostgreSQL (used by settings_production.py) ----
DB_NAME=agri_dashboard
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432

# ---- Django ----
SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://localhost

# ---- Redis / Celery ----
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# ---- Google Earth Engine (for `python manage.py pull_satellite`) ----
# Absolute path to your Google service-account JSON. See DATAINGEST_GUIDE.md
# "Google Earth Engine" section for how to create one.
GEE_CREDENTIALS_FILE=C:\path\to\gee-service-account.json
# Optional: GEE project id (shown as "Earth Engine project" in the admin UI).
GEE_PROJECT=ee-yourusername

# ---- SSL / Security (production) ----
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ---- Map tiles (served through /api/tiles/...) ----
# Real contact address sent in the tile User-Agent. Esri, MapTiler, OpenStreetMap,
# ... all ask for an identifiable app + contact, and answer 403 ("access
# blocked") when they do not get one.
TILE_PROVIDER_CONTACT=you@example.org
# Optional: use a keyed tile provider instead of the free public ones.
# URL templates accept {z}/{x}/{y} (and {r} for retina tiles). When set, this
# provider is tried first; the free public hosts stay as fallbacks.
# Remember to add its credit to ATTRIBUTIONS in static/dashboard/js/map-tiles.js.
#TILE_PROVIDER_MAP_URL=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
#TILE_PROVIDER_MAP_NAME=MapTiler
#TILE_PROVIDER_TERRAIN_URL=https://api.maptiler.com/maps/topo/256/{z}/{x}/{y}.png?key=YOUR_KEY
#TILE_PROVIDER_TERRAIN_NAME=MapTiler Topo
#TILE_PROVIDER_SATELLITE_URL=https://api.maptiler.com/maps/satellite/256/{z}/{x}/{y}.png?key=YOUR_KEY
#TILE_PROVIDER_SATELLITE_NAME=MapTiler Satellite
# On-disk tile cache: every tile is fetched from the provider once, then served
# from here by every worker and every restart. Safe to delete; give it a few GB.
#TILE_CACHE_DIR=/var/data/tilecache
# Upstream fetches are throttled to this many at a time: the public hosts drop
# connections when a map load asks for ~20 tiles at once.
#TILE_UPSTREAM_CONCURRENCY=4

# ---- Logging ----
DJANGO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# AgroAI assistant - retrieval augmented generation
# ---------------------------------------------------------------------------
# Ask one short question instead of guessing when a question does not name a
# region or a topic. Set to 0 to always answer with the best available guess.
#ASSISTANT_CLARIFY=1
# Retrieval chunks docs/*.md + the crop knowledge base and adds live digests
# from the database. Set RAG_ENABLED=0 to answer from the deterministic facts
# only (identical behaviour to the pre-RAG assistant).
RAG_ENABLED=1
# Dense channel: local Ollama embedding model (multilingual: en/fr/ar).
# Install once with:  ollama pull bge-m3
# Leave as-is if the model is missing: the TF-IDF channel still works.
RAG_EMBED_MODEL=bge-m3
#RAG_OLLAMA_URL=http://localhost:11434
#RAG_EMBED_TIMEOUT=300
RAG_TOP_K=4
RAG_LEXICAL_DEPTH=12
RAG_MAX_CONTEXT_CHARS=2600
RAG_MIN_SCORE=0.01
RAG_DATA_WINDOW_DAYS=400
# Build embeddings on demand when the index is missing (blocking: prefer
# running "python manage.py build_assistant_index" instead).
RAG_AUTO_EMBED=0
#RAG_DOCS_DIR=/path/to/your/knowledge/folder
#RAG_INDEX_DIR=/var/data/assistant_index
