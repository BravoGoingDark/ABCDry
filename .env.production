# ============================================================================
# Environment Variables Configuration
# File: .env or .env.production
# Purpose: Database and service credentials (NEVER commit to git)
# ============================================================================

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=agri_db
DB_USER=agri_app_user
DB_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432

# Replica database (for read-only operations)
DB_REPLICA_HOST=replica.example.com
DB_REPLICA_PORT=5432

# ============================================================================
# REDIS CACHE & CELERY
# ============================================================================
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ============================================================================
# DJANGO SETTINGS
# ============================================================================
DJANGO_SETTINGS_MODULE=agri_dashboard.settings_production
DEBUG=False
SECRET_KEY=your_secret_key_here_change_in_production
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com
DJANGO_LOG_LEVEL=INFO

# ============================================================================
# SECURITY & SSL
# ============================================================================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
GEOS_LIBRARY_PATH=/usr/lib/libgeos_c.so.1
GDAL_LIBRARY_PATH=/usr/lib/libgdal.so.30

# ============================================================================
# PGBOUNCER CONNECTION POOLING
# ============================================================================
PGBOUNCER_HOST=localhost
PGBOUNCER_PORT=6432
PGBOUNCER_POOL_MODE=transaction
PGBOUNCER_DEFAULT_POOL_SIZE=25

# ============================================================================
# BACKUP & RECOVERY (pgBackRest)
# ============================================================================
BACKUP_ENABLED=True
BACKUP_PATH=/backups/pgbackrest
BACKUP_RETENTION_DAYS=30
PGBACKREST_REPO1_PATH=/var/lib/pgbackrest
PGBACKREST_CIPHER_PASS=your_backup_encryption_key
PGBACKREST_STANZA=agri_db

# ============================================================================
# MONITORING & LOGGING
# ============================================================================
MONITORING_ENABLED=True
LOG_LEVEL=INFO
LOG_FILE=/var/log/agri_dashboard/django.log

# ============================================================================
# SMTP EMAIL (for alerts and notifications)
# ============================================================================
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password

# ============================================================================
# SLACK NOTIFICATIONS (for alerts)
# ============================================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# ============================================================================
# AWS S3 (for long-term backup storage)
# ============================================================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=agri-dashboard-backups
AWS_S3_REGION_NAME=us-east-1

# ============================================================================
# AZURE BLOB STORAGE (alternative to S3)
# ============================================================================
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
AZURE_STORAGE_ACCOUNT_KEY=your_storage_key
AZURE_STORAGE_CONTAINER_NAME=agri-backups

# ============================================================================
# TIMESCALEDB SETTINGS
# ============================================================================
TIMESCALEDB_COMPRESSION_INTERVAL=30 days
TIMESCALEDB_RETENTION_INTERVAL=2 years
TIMESCALEDB_CHUNK_TIME_INTERVAL=1 day

# ============================================================================
# TIME ZONE
# ============================================================================
TZ=UTC
# Or set to your region: TZ=Africa/Tunis

# ============================================================================
# SECURITY CHECKLIST
# ============================================================================
# Before deploying to production:
# 1. [ ] Generate new SECRET_KEY (use: python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
# 2. [ ] Set unique DB_PASSWORD (20+ chars, alphanumeric + special chars)
# 3. [ ] Generate PGBACKREST_CIPHER_PASS for backup encryption
# 4. [ ] Set SLACK_WEBHOOK_URL for operational alerts
# 5. [ ] Configure EMAIL settings for admin notifications
# 6. [ ] Restrict .env file permissions: chmod 600 .env
# 7. [ ] Add .env to .gitignore to prevent accidental commits
# 8. [ ] Rotate all passwords every 90 days
# 9. [ ] Enable SSL/TLS for all external connections
# 10. [ ] Setup 2FA for database admin accounts
# 11. [ ] Configure firewall rules to limit DB access
# 12. [ ] Enable PostgreSQL audit logging (pgaudit extension)
# 13. [ ] Setup automated backup verification
# 14. [ ] Test disaster recovery procedure quarterly
#
# ============================================================================
